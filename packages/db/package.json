{
  "name": "db",
  "version": "1.0.0",
  "type": "module",
  "description": "Prisma schema and DB client for Cortex",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./generated/prisma/index.d.ts",
      "default": "./generated/prisma/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "invariant": "^2.2.4"
  },
  "devDependencies": {
    "@cortex/typescript-config": "workspace:*",
    "@types/invariant": "^2.2.37",
    "@types/node": "^22.0.0",
    "prisma": "^7.8.0",
    "typescript": "5.9.2",
    "vitest": "^5.0.5"
  }
}
