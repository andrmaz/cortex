{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["typescript", "oxc", "react"],
  "env": {
    "browser": true,
    "serviceworker": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "react/error-boundaries": "off"
  }
}
