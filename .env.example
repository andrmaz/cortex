# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cortex"

# BullMQ ingestion queue
REDIS_URL="redis://localhost:6379"
# Set to "false" to run the API without starting the ingestion worker
INGESTION_WORKER_ENABLED="true"

# Embeddings: "deterministic" (local/dev) or "openai"
EMBEDDING_PROVIDER="deterministic"
# OPENAI_API_KEY="sk-..."
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Google OAuth 2.0
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# QA fixture login (never enabled in production): set to "true" to allow
# GET /auth/dev-login (fixture admin only; requires NODE_ENV=development|test) after running `pnpm --filter @cortex/api seed:fixture`
# CORTEX_DEV_LOGIN="true"

# Web app (Next.js admin UI)
CORTEX_WEB_URL="http://localhost:3000"
CORTEX_API_URL="http://localhost:4000"

# JWT
# Use a long, random secret in production: `openssl rand -base64 64`
JWT_SECRET="changeme-dev-secret"
